+   move.l   (ASM_PREFIX(_psp_saved_acr1)),d0
+   rts
+   ASM_CONST16(0x0000)
+gl_acr2:
+
+|   cmpi     #2,d0
+   cmpi.l   #2,d0
+
+   bne.b    gl_acr3
+   move.l   ASM_PREFIX(_psp_saved_acr2), d0
